---
import Logo from '../components/Logo.astro';

const navItems = [
    { linkText: 'Equipo', href: '#equipo' },
    { linkText: 'El camino', href: '#camino' },
    { linkText: 'Contacto', href: '#contacto' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 py-6 sm:py-8">
    <a href="/" class="shrink-0">
        <Logo />
    </a>
    <ul class="flex flex-wrap items-center gap-x-1 gap-y-1 sm:gap-x-2">
        {
            navItems.map((item) => (
                <li>
                    <a href={item.href} class="inline-block px-2 py-1 no-underline sm:px-3 sm:py-2 text-sm text-graphite hover:text-gold transition-colors">
                        {item.linkText}
                    </a>
                </li>
            ))
        }
        <li>
            <a href="tel:+34613959332" class="btn ml-2">613 95 93 32</a>
        </li>
    </ul>
</nav>
