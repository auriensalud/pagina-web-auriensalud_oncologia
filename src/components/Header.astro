---
import Logo from '../components/Logo.astro';

const navItems = [
    { linkText: 'Es para mí', href: '#ahora-que' },
    { linkText: 'Equipo', href: '#equipo' },
    { linkText: 'Recupérate', href: '#camino' }
];
---

<nav class="sticky top-0 z-40">
    <div class="relative border-b full-bleed bg-parchment/95 backdrop-blur-sm border-pressed-cotton">
        <div class="flex flex-wrap items-center justify-between gap-4 px-6 py-5 mx-auto max-w-5xl sm:px-12 sm:py-6">
            <a href="/" class="shrink-0">
                <Logo />
            </a>
            <ul class="flex flex-wrap items-center gap-x-1 gap-y-1 sm:gap-x-2">
                {
                    navItems.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                class="relative inline-block px-2 py-1 text-base font-medium no-underline transition-colors sm:px-3 sm:py-2 text-graphite hover:text-gold after:absolute after:inset-x-2 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-gold after:transition-transform after:duration-300 hover:after:scale-x-100 sm:after:inset-x-3"
                            >
                                {item.linkText}
                            </a>
                        </li>
                    ))
                }
                <li>
                    <a href="#contacto" class="btn ml-2">Te ayudamos</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
