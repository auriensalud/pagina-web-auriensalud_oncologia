---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import entrada from '../assets/entrada-aurien-salud.jpg';
import pasillo from '../assets/pasillo-aurien-salud.jpg';
import terapeutaLuis from '../assets/terapeuta-luis.jpg';
import consulta from '../assets/consulta-aurien-salud.jpg';
import logoPared from '../assets/logo-pared-aurien.jpg';
import valoracion from '../assets/valoracion-composicion-corporal.jpg';

const especialidades = ['Oncología', 'Fisioterapia', 'Nutrición', 'Psicología'];

const equipo = [
    {
        nombre: 'Jacobo Abad',
        rol: 'Oncología',
        estado: 'confirmado'
    },
    {
        nombre: 'María Bernárdez',
        rol: 'Gerencia',
        estado: 'confirmado'
    },
    {
        nombre: 'Adrián Martín',
        rol: 'Fisioterapia',
        estado: 'confirmado'
    },
    {
        nombre: 'Inés Viñas',
        rol: 'Nutrición',
        estado: 'confirmado'
    },
    {
        nombre: 'Psicología',
        rol: 'Por confirmar',
        estado: 'pendiente'
    }
];

const servicios = [
    {
        paso: '01',
        titulo: 'Control',
        descripcion:
            'Valoración inicial multidisciplinar con oncología, fisioterapia, psicología y nutrición. Un punto de partida seguro: qué puedes y qué no puedes hacer ahora mismo, sin genéricos.'
    },
    {
        paso: '02',
        titulo: 'Cuidado',
        descripcion:
            'Programa de ejercicio guiado y acompañamiento continuo, ajustado a tu energía y a tu momento. A tu ritmo, nunca al de un grupo.'
    },
    {
        paso: '03',
        titulo: 'Prevención',
        descripcion:
            'Mantenimiento a largo plazo: recuperar tus rutinas, tu vida social y prevenir recaídas funcionales. El camino de vuelta a ser tú misma.'
    }
];

const whatsappHref =
    'https://wa.me/34613959332?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20una%20primera%20valoraci%C3%B3n%20para%20el%20programa%20de%20Salud%20Onco-Metab%C3%B3lica.';

const slideshow = [
    { src: entrada, alt: 'Entrada de la clínica Aurien Salud en Ourense', position: '50% 50%' },
    { src: pasillo, alt: 'Pasillo y sala de espera de la clínica Aurien Salud', position: '50% 50%' },
    {
        src: terapeutaLuis,
        alt: 'Terapeuta atendiendo a un paciente en Aurien Salud, paciente autorizó el uso de esta foto',
        position: '50% 10%'
    },
    { src: consulta, alt: 'Consulta en Aurien Salud, paciente autorizó el uso de esta foto', position: '50% 22%' },
    { src: logoPared, alt: 'Logotipo de Aurien Salud en la pared de la clínica', position: '50% 50%' }
];
---

<Layout title="Salud Onco-Metabólica — Aurien Salud">
    <div class="flex flex-col gap-24 sm:gap-32">
        <!-- Franja horizontal a pantalla completa bajo el menú: slideshow con fondo desenfocado
             (para rellenar la caja) + la foto completa sin recortar encima, para no perder nada
             de imagen sea cual sea su forma (la mayoría de las fotos reales son verticales). -->
        <div class="relative overflow-hidden full-bleed aspect-3/2 sm:aspect-2/1 kenburns-slideshow">
            {
                slideshow.map((photo, i) => (
                    <div class:list={['absolute inset-0 slide', `slide-${i + 1}`]}>
                        <Image
                            src={photo.src}
                            alt={photo.alt}
                            class="absolute inset-0 object-cover w-full h-full"
                            style={{ objectPosition: photo.position }}
                            widths={[640, 1024, 1920]}
                            sizes="100vw"
                        />
                    </div>
                ))
            }
        </div>

        <style>
            .full-bleed {
                width: 100vw;
                left: 50%;
                margin-left: -50vw;
            }
            .kenburns-slideshow .slide {
                opacity: 0;
                animation: kenburns-fade 40s infinite;
                animation-timing-function: ease-in-out;
            }
            .kenburns-slideshow .slide-1 {
                animation-delay: 0s;
            }
            .kenburns-slideshow .slide-2 {
                animation-delay: -8s;
            }
            .kenburns-slideshow .slide-3 {
                animation-delay: -16s;
            }
            .kenburns-slideshow .slide-4 {
                animation-delay: -24s;
            }
            .kenburns-slideshow .slide-5 {
                animation-delay: -32s;
            }
            @keyframes kenburns-fade {
                0%, 17% { opacity: 1; }
                20%, 97% { opacity: 0; }
                100% { opacity: 1; }
            }
            @media (prefers-reduced-motion: reduce) {
                .kenburns-slideshow .slide {
                    animation: none;
                    opacity: 1;
                }
                .kenburns-slideshow .slide-2,
                .kenburns-slideshow .slide-3,
                .kenburns-slideshow .slide-4,
                .kenburns-slideshow .slide-5 {
                    display: none;
                }
            }
        </style>

        <!-- Hero -->
        <section>
            <h1 class="max-w-3xl mb-6">¿Quieres recuperar tu mejor versión?</h1>
            <details class="mb-8 group">
                <summary class="inline-block cursor-pointer eyebrow list-none marker:content-none">
                    ¿Esto te interesa?
                </summary>
                <div class="mt-4">
                    <p class="mb-2 font-display text-2xl">Atención oncológica integral</p>
                    <ul class="flex flex-wrap gap-x-5 gap-y-1">
                        {
                            especialidades.map((especialidad) => (
                                <li class="text-sm text-slate">{especialidad}</li>
                            ))
                        }
                    </ul>
                </div>
            </details>
            <div class="flex flex-wrap items-center gap-4">
                <a href="#contacto" class="btn btn-lg">Pide tu primera valoración</a>
                <a href={whatsappHref} class="btn-ghost" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>
            </div>
        </section>

        <!-- Quiénes somos -->
        <section id="quienes-somos" class="grid gap-10 sm:grid-cols-2 sm:gap-16">
            <div>
                <p class="eyebrow mb-4">Quiénes somos</p>
                <h2 class="mb-6">Una casa, no un gimnasio con extras.</h2>
            </div>
            <div class="flex flex-col gap-4 text-slate">
                <p>
                    Aurien Salud (Clínica Aurien Salud HBM SL) es una clínica multidisciplinar privada en Rúa do Concello 12, Ourense, con
                    consultas propias y gimnasio de rehabilitación, en funcionamiento desde febrero de 2025.
                </p>
                <p>
                    Nacimos centrados en rehabilitación cardíaca y cardiorrespiratoria. El programa de Salud Onco-Metabólica extiende el mismo
                    modelo: recuperación funcional a través del ejercicio, con respaldo sanitario real detrás — no un gimnasio con extras.
                </p>
                <p class="text-graphite">
                    María Bernárdez lleva la gerencia de Aurien Salud y es quien sostiene el día a día de esta casa.
                    <span class="italic text-dusk">[Pendiente: una frase suya, en primera persona, sobre por qué existe este programa]</span>
                </p>
            </div>
        </section>

        <!-- Programa / Servicios -->
        <section id="programa">
            <p class="eyebrow mb-4">El programa</p>
            <h2 class="max-w-2xl mb-4">Control, Cuidado y Prevención.</h2>
            <p class="max-w-xl mb-12 text-lg text-slate">
                La misma metodología que ya usamos en Recupera tu Corazón o Respira Mejor, adaptada a la recuperación metabólica y funcional tras
                un tratamiento oncológico.
            </p>
            <div class="grid gap-8 sm:grid-cols-3 sm:gap-6">
                {
                    servicios.map((servicio) => (
                        <div class="overflow-hidden bg-linen rounded-md">
                            {servicio.titulo === 'Control' && (
                                <Image src={valoracion} alt="Valoración de composición corporal en Aurien Salud" class="object-cover w-full h-40" widths={[400, 600]} sizes="400px" />
                            )}
                            <div class="p-8">
                                <p class="mb-4 font-display text-3xl text-gold">{servicio.paso}</p>
                                <h3 class="mb-3">{servicio.titulo}</h3>
                                <p class="text-sm text-slate">{servicio.descripcion}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- Valores -->
        <section class="p-10 bg-linen rounded-md sm:p-16">
            <p class="eyebrow mb-4">Cómo trabajamos</p>
            <div class="grid gap-8 sm:grid-cols-2">
                <div>
                    <h3 class="mb-2">Casa, seguro, tranquilidad</h3>
                    <p class="text-sm text-slate">Los mismos tres pilares de Aurien Salud, que aquí encajan mejor que en ningún otro programa.</p>
                </div>
                <div>
                    <h3 class="mb-2">Acompañamiento real</h3>
                    <p class="text-sm text-slate">No tienes que decidir esto sola. No prometemos victorias, prometemos estar cerca.</p>
                </div>
                <div>
                    <h3 class="mb-2">Tu ritmo, no el de un grupo</h3>
                    <p class="text-sm text-slate">Nadie se compara ni se exige al nivel de otra paciente.</p>
                </div>
                <div>
                    <h3 class="mb-2">Seguridad clínica primero</h3>
                    <p class="text-sm text-slate">Por delante de cualquier objetivo estético o de rendimiento.</p>
                </div>
            </div>
        </section>

        <!-- Equipo -->
        <section id="equipo">
            <p class="eyebrow mb-4">El equipo</p>
            <h2 class="max-w-2xl mb-12">Caras y nombres, no solo un monitor.</h2>
            <div class="grid grid-cols-2 gap-6 sm:grid-cols-5">
                {
                    equipo.map((persona) => (
                        <div class="text-center">
                            <div
                                class:list={[
                                    'flex items-center justify-center mb-3 aspect-square rounded-full',
                                    persona.estado === 'pendiente' ? 'bg-pressed-cotton' : 'bg-gold/20'
                                ]}
                            >
                                <span class="font-display text-2xl text-gold">
                                    {persona.estado === 'pendiente' ? '?' : persona.nombre.charAt(0)}
                                </span>
                            </div>
                            <p class="text-sm font-medium text-graphite">{persona.nombre}</p>
                            <p class:list={['text-xs', persona.estado === 'pendiente' ? 'italic text-dusk' : 'text-slate']}>{persona.rol}</p>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- CTA final -->
        <section class="p-10 text-center bg-graphite rounded-md sm:p-20">
            <h2 class="max-w-lg mx-auto mb-4 text-parchment">No tienes que decidir esto sola.</h2>
            <p class="max-w-md mx-auto mb-8 text-lg text-pressed-cotton">Hablemos primero.</p>
            <div class="flex flex-wrap items-center justify-center gap-4">
                <a href="tel:+34613959332" class="btn btn-lg">613 95 93 32</a>
                <a href={whatsappHref} class="btn-ghost" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>
            </div>
        </section>
    </div>
</Layout>
