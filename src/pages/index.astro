---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import entrada from '../assets/entrada-aurien-salud.jpg';
import pasillo from '../assets/pasillo-aurien-salud.jpg';
import terapeutaLuis from '../assets/terapeuta-luis.jpg';
import consulta from '../assets/consulta-aurien-salud.jpg';
import logoPared from '../assets/logo-pared-aurien.jpg';

const especialidades = ['Oncología', 'Fisioterapia', 'Nutrición', 'Psicología'];

// Un icono de línea sencillo por especialidad — sin nombres de profesionales.
const especialidadIconos: Record<string, string> = {
    Oncología:
        'M12 3c-1.2 2-1.2 4 0 6M9 9c-3 1-5 3-5 6a8 8 0 0 0 16 0c0-3-2-5-5-6M12 9v12',
    Fisioterapia: 'M12 4a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM7 21l3-7 2-3 2 3 3 7M9 14l-3-2M15 14l3-2',
    Nutrición: 'M12 3c4 0 7 3 7 7 0 6-4 11-7 11S5 16 5 10c0-4 3-7 7-7ZM12 3c0 3-1 5-3 6',
    Psicología: 'M9 3a5 5 0 0 0-5 5c0 2 1 3 1 5 0 2-1 3-1 5a2 2 0 0 0 2 2h1v-3M9 3a5 5 0 0 1 5 5c0 1-.5 2-1 3M14 8h4M13 12h4'
};

const equipoBloques = [
    { titulo: 'Oncología', sub: 'Valoración clínica', icono: especialidadIconos['Oncología'] },
    { titulo: 'Fisioterapia + Ejercicio', sub: 'Capacidad física', icono: especialidadIconos['Fisioterapia'] },
    { titulo: 'Nutrición', sub: 'Alimentación y composición corporal', icono: especialidadIconos['Nutrición'] },
    { titulo: 'Psicología', sub: 'Bienestar emocional', icono: especialidadIconos['Psicología'] }
];

const caminoPasos = ['Te valoramos', 'Empiezas a moverte', 'Recuperas capacidad', 'Ganas confianza'];

const preguntasCarrusel = ['¿Puedo hacer ejercicio?', '¿Cómo recupero mi fuerza?', '¿Por dónde empiezo?'];

const whatsappHref =
    'https://wa.me/34613959332?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20una%20primera%20valoraci%C3%B3n%20para%20el%20programa%20de%20Salud%20Onco-Metab%C3%B3lica.';

const slideshow = [
    { src: entrada, alt: 'Entrada de la clínica Aurien Salud en Ourense', position: '50% 50%' },
    { src: pasillo, alt: 'Pasillo y sala de espera de la clínica Aurien Salud', position: '50% 50%' },
    {
        src: terapeutaLuis,
        alt: 'Terapeuta atendiendo a un paciente en Aurien Salud, paciente autorizó el uso de esta foto',
        position: '50% 10%'
    },
    { src: consulta, alt: 'Consulta en Aurien Salud, paciente autorizó el uso de esta foto', position: '50% 22%' },
    { src: logoPared, alt: 'Logotipo de Aurien Salud en la pared de la clínica', position: '50% 50%' }
];
---

<Layout title="Aurien Onco-Metabólico">
    <div class="flex flex-col gap-28 sm:gap-40">
        <!-- ============================================================
             HERO / PORTADA
             Slideshow a pantalla completa (transición lenta entre escenas
             reales: entrada, pasillo, acompañamiento, logo). CTA visible
             sin hacer scroll.
        ============================================================= -->
        <div class="relative overflow-hidden full-bleed aspect-3/2 sm:aspect-2/1 kenburns-slideshow">
            {
                slideshow.map((photo, i) => (
                    <div class:list={['absolute inset-0 slide', `slide-${i + 1}`]}>
                        <Image
                            src={photo.src}
                            alt={photo.alt}
                            class="absolute inset-0 object-cover w-full h-full"
                            style={{ objectPosition: photo.position }}
                            widths={[640, 1024, 1920]}
                            sizes="100vw"
                        />
                    </div>
                ))
            }
        </div>

        <section>
            <h1 class="mb-2">El tratamiento termina.</h1>
            <p class="mb-4 font-display text-4xl text-gold sm:text-5xl">Tu recuperación continúa.</p>
            <p class="inline-block px-4 py-2 mb-6 text-xs text-center eyebrow bg-linen rounded-2xl sm:text-sm">
                Primer centro sanitario en ejercicio oncológico en Ourense
            </p>
            <p class="max-w-xl mb-6 text-lg text-slate">
                Te ayudamos a recuperar <strong class="font-semibold text-graphite">fuerza, confianza y autonomía</strong> para volver a una
                vida activa.
            </p>
            <p class="mb-8 eyebrow">{especialidades.join(' · ')}</p>
            <a href="#contacto" class="btn btn-md">Quiero empezar</a>
        </section>

        <!-- ============================================================
             BLOQUE 01 · ¿Y AHORA QUÉ?
             Sin fotografía, tipografía grande, mucho espacio en blanco.
        ============================================================= -->
        <section id="ahora-que" class="max-w-3xl">
            <p class="mb-2 eyebrow">El tratamiento termina...</p>
            <h2 class="mb-10">¿Y ahora qué?</h2>
            <div class="relative min-h-[140px] mb-12 sm:min-h-[110px] qa-carousel">
                {
                    preguntasCarrusel.map((pregunta, i) => (
                        <p class:list={['absolute inset-0 font-display text-3xl text-graphite sm:text-4xl qa-slide', `qa-slide-${i + 1}`]}>{pregunta}</p>
                    ))
                }
            </div>
            <p class="mb-2 text-sm eyebrow">La solución</p>
            <p class="text-lg text-slate">
                No es un gimnasio.<br />
                Es un espacio sanitario donde aprender a <strong class="font-semibold text-graphite">volver a moverte con seguridad</strong>.
            </p>
        </section>

        <!-- ============================================================
             BLOQUE 02 · EQUIPO
             4 iconos lineales convergiendo hacia un elemento central: TÚ.
             Desktop: en línea. Móvil: 2x2.
        ============================================================= -->
        <section id="equipo">
            <h2 class="mb-2">No tienes que hacerlo solo.</h2>
            <p class="mb-12 text-lg text-slate">Un equipo para acompañarte.</p>
            <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 sm:gap-6">
                {
                    equipoBloques.map((item) => (
                        <div class="text-center">
                            <div class="flex items-center justify-center mx-auto mb-4 rounded-full w-14 h-14 bg-gold/20">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 text-gold">
                                    <path d={item.icono} />
                                </svg>
                            </div>
                            <p class="mb-1 text-sm font-semibold tracking-wide uppercase text-graphite">{item.titulo}</p>
                            <p class="text-sm text-slate">{item.sub}</p>
                        </div>
                    ))
                }
            </div>
            <div class="relative hidden h-px mt-12 sm:block bg-pressed-cotton">
                <span class="absolute flex items-center justify-center w-16 h-16 -translate-x-1/2 -translate-y-1/2 rounded-full left-1/2 top-1/2 bg-gold font-display text-graphite">
                    Tú
                </span>
            </div>
            <p class="mt-16 text-lg text-center text-slate sm:mt-10">Un equipo. Una misma dirección: tú.</p>
        </section>

        <!-- ============================================================
             BLOQUE 03 · EL CAMINO
             Principal recurso gráfico de la web: recorrido horizontal en
             desktop, vertical en móvil, con activación progresiva al
             hacer scroll.
        ============================================================= -->
        <section id="camino">
            <h2 class="mb-16 max-w-2xl">Del tratamiento a tu vida.</h2>
            <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-3">
                {
                    caminoPasos.map((paso, i) => (
                        <>
                            <p class="min-w-0 reveal font-display text-2xl text-graphite sm:flex-1 sm:text-xl">{paso}</p>
                            <span class="text-2xl text-gold rotate-90 shrink-0 sm:rotate-0" aria-hidden="true">→</span>
                        </>
                    ))
                }
                <p class="min-w-0 reveal font-display text-3xl text-gold sm:flex-1 sm:text-2xl">Continúas</p>
            </div>
            <p class="max-w-sm mt-10 text-slate">
                En tu gimnasio.<br />
                En tu deporte.<br />
                En tu día a día.
            </p>
        </section>

        <!-- ============================================================
             BLOQUE 04 · CIERRE EMOCIONAL
             [PENDIENTE DE FOTO]: aquí debería ir una foto/vídeo de vida
             activa fuera de la clínica (caminar, bici, familia,
             naturaleza...). No usamos ninguna porque no tenemos ese
             material real todavía — solo fotos de la propia clínica.
             Cuando la tengáis, sustituir este bloque de color por la
             imagen a pantalla completa.
        ============================================================= -->
        <section class="p-10 text-center rounded-3xl bg-linen sm:p-20">
            <h2 class="max-w-xl mx-auto mb-2">Nuestro objetivo no es que te quedes.</h2>
            <p class="max-w-xl mx-auto mb-6 font-display text-3xl text-gold sm:text-4xl">Es que vuelvas a sentirte capaz.</p>
            <p class="max-w-md mx-auto mb-8 text-slate">
                Te acompañamos para que recuperes las herramientas necesarias para <strong
                    class="font-semibold text-graphite">seguir avanzando por ti</strong>.
            </p>
            <p class="max-w-md mx-auto mb-8 font-medium text-graphite">Aurien es el puente entre el tratamiento y una vida activa.</p>
            <a href="#contacto" class="btn btn-md">Quiero empezar</a>
        </section>

        <!-- ============================================================
             CTA FINAL
        ============================================================= -->
        <section id="contacto" class="p-10 text-center bg-graphite rounded-3xl sm:p-20">
            <h2 class="max-w-lg mx-auto mb-4 text-parchment">¿Empezamos?</h2>
            <p class="max-w-md mx-auto mb-8 text-lg text-pressed-cotton">
                El primer paso es conocer <strong class="font-semibold text-white">desde dónde partes</strong>.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
                <a href="tel:+34613959332" class="btn btn-lg">Pedir valoración · 613 95 93 32</a>
                <a href={whatsappHref} class="btn-ghost" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>
            </div>
            <p class="mb-2 font-display text-xl text-parchment">Aurien Onco-Metabólico</p>
            <p class="mb-4 text-sm eyebrow">{especialidades.join(' · ')}</p>
            <p class="text-pressed-cotton">La puerta hacia tu recuperación.</p>
        </section>
    </div>

    <style>
        .kenburns-slideshow .slide {
            opacity: 0;
            animation: kenburns-fade 40s infinite;
            animation-timing-function: ease-in-out;
        }
        .kenburns-slideshow .slide-1 {
            animation-delay: 0s;
        }
        .kenburns-slideshow .slide-2 {
            animation-delay: -8s;
        }
        .kenburns-slideshow .slide-3 {
            animation-delay: -16s;
        }
        .kenburns-slideshow .slide-4 {
            animation-delay: -24s;
        }
        .kenburns-slideshow .slide-5 {
            animation-delay: -32s;
        }
        @keyframes kenburns-fade {
            0%, 17% { opacity: 1; }
            20%, 97% { opacity: 0; }
            100% { opacity: 1; }
        }
        @media (prefers-reduced-motion: reduce) {
            .kenburns-slideshow .slide {
                animation: none;
                opacity: 1;
            }
            .kenburns-slideshow .slide-2,
            .kenburns-slideshow .slide-3,
            .kenburns-slideshow .slide-4,
            .kenburns-slideshow .slide-5 {
                display: none;
            }
        }

        /* Carrusel de texto de "¿Y ahora qué?": las preguntas se van
           encadenando antes de dar paso a la solución. */
        .qa-slide {
            opacity: 0;
            animation: qa-fade 12s infinite;
            animation-timing-function: ease-in-out;
        }
        .qa-slide-1 {
            animation-delay: 0s;
        }
        .qa-slide-2 {
            animation-delay: -4s;
        }
        .qa-slide-3 {
            animation-delay: -8s;
        }
        @keyframes qa-fade {
            0%, 21% { opacity: 1; }
            25%, 96% { opacity: 0; }
            100% { opacity: 1; }
        }
        @media (prefers-reduced-motion: reduce) {
            .qa-slide {
                position: static;
                animation: none;
                opacity: 1;
                margin-bottom: 0.75rem;
            }
        }
    </style>

    <script>
        // Revelado progresivo al hacer scroll (bloques "¿Y ahora qué?" y "El camino").
        // Si JS no llega a correr, los elementos se quedan visibles por defecto:
        // solo los ocultamos si vamos a poder animarlos de vuelta.
        const els = document.querySelectorAll<HTMLElement>('.reveal');
        if ('IntersectionObserver' in window && els.length) {
            els.forEach((el) => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(12px)';
                el.style.transition = 'opacity .6s ease, transform .6s ease';
            });
            const io = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            const el = entry.target as HTMLElement;
                            el.style.opacity = '1';
                            el.style.transform = 'none';
                            io.unobserve(el);
                        }
                    });
                },
                { threshold: 0.2 }
            );
            els.forEach((el) => io.observe(el));
        }
    </script>
</Layout>
